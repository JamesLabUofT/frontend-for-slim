// CUSTOM FUNCTIONS //

// Estimate Ne based on Heterozygosity
function (float)estimateNe_Heterozygosity(o<Subpopulation>$ subpop)
{
	pi = calcHeterozygosity(subpop.genomes);
	return pi / (4 * MU);
}
