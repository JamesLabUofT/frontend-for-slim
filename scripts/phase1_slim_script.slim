//////////////////////
1:early()
{

// BURNIN STAGGER -> WHEN IN BURNIN, POP VARY AROUND WHAT WE WANT INIT POP TO BE => N0

if (sim.cycle <= burnin)
	{
	if (dyn_burn == 1)
		{	
		inds = p1.individuals;
		inds[inds.age > 0].fitnessScaling = 0.0;
		n_t_plus_pt5 = sum(inds.age == 0);
		p1.fitnessScaling = N0/n_t_plus_pt5;
		}
	if (dyn_burn == 0)
		{
		togo = sample(p1.individuals, asInteger(p1.individualCount - N0));
		sim.killIndividuals(togo);
		}
	}
if (sim.cycle > burnin)
	{
	oldies = p1.subsetIndividuals(minAge=1);
	sim.killIndividuals(oldies);
	ind_no = p1.individualCount;

	doomlist = ind_no - round(max(minPop, kDyn[kDyn_key]));
	if (doomlist > 0)
		{
		doomchild = sample(p1.individuals, asInteger(doomlist));
		sim.killIndividuals(doomchild);
		}
	defineGlobal("kDyn_key", kDyn_key + 1);	
			
	}
}


////////////////////
1:late()
{
for (b in sim.subpopulations)
	{
	n_t.setValue(b.id, c(n_t.getValue(b.id), b.individualCount));
	}

if (sim.cycle <= burnin) // before and including burnin
	{
	for (l in community.logFiles)
			{
			l.logRow();
			}
		if (sim.cycle == burnin)
			{
		
			for (b in sim.subpopulations)
				{
				p1.genomes.outputVCF(paste0(directory,"/VCF_p"+b.id+"_"+idtag+"_g"+sim.cycle+".vcf"), outputMultiallelics = F);
				}
			defineGlobal("logclock", logclock+1);	
			}
	}
if (sim.cycle > burnin)
	{		
	if (logclock == sampfr)
		{
		for (l in community.logFiles)
			{
			l.logRow();
			}
		for (b in sim.subpopulations)
			{
			p1.genomes.outputVCF(paste0(directory,"/VCF_p"+b.id+"_"+idtag+"_g"+sim.cycle+".vcf"), outputMultiallelics = F);
			}
		defineGlobal("logclock", 0);
		}
	if (logclock < sampfr)
		{
		defineGlobal("logclock", logclock+1);
		}				
	}	
}


//
STOPPER late() {
	sim.outputFull(ages=T); // end gen
	for (b in sim.subpopulations)
	{
	out_vect = c(n_t.getValue(b.id));
	writeFile(paste0(directory,"/OUTTEST",b.id,"_",idtag,".txt"), asString(out_vect), append=F);
	}
}


